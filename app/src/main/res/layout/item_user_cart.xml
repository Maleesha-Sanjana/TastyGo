<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_cart_food_thumb"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Food Image"
            android:scaleType="centerCrop"
            android:src="@drawable/real_food_burger"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_cart_food_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:text="Classic Cheeseburger"
                    android:textColor="@color/text_ink"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btn_cart_delete"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Remove"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_cart_item_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="2"
                android:text="Regular • Extra Cheese"
                android:textColor="@color/text_caption"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_cart_item_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Rs. 950.00"
                    android:textColor="@color/primary_chili"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_white"
                    android:backgroundTint="@color/mist"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btn_cart_minus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Decrease"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/text_ink" />

                    <TextView
                        android:id="@+id/tv_cart_qty"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/text_ink"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btn_cart_plus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Increase"
                        android:src="@drawable/ic_add"
                        app:tint="@color/text_ink" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
