<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_mist"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:elevation="@dimen/app_bar_elevation"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="My Cart"
            android:textColor="@color/text_ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_cart_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Review your order details before checkout"
            android:textColor="@color/text_caption"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Active Cart Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_cart_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="90dp">

                <!-- Cart Items List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cart_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_user_cart" />

                <!-- Coupon Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Have a promo code?"
                            android:textColor="@color/text_ink"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_coupon_code"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_white"
                                android:backgroundTint="@color/mist"
                                android:fontFamily="@font/poppins_medium"
                                android:hint="Enter coupon (e.g. TASTY20)"
                                android:inputType="textCapCharacters"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/text_ink"
                                android:textColorHint="@color/text_caption"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_apply_coupon"
                                style="@style/Widget.TastyGo.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/poppins_semibold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="16dp"
                                android:text="Apply"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Applied Coupon Info Tag -->
                        <LinearLayout
                            android:id="@+id/layout_coupon_applied"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_chip_white"
                            android:backgroundTint="@color/basil_tint"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Applied"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/status_basil" />

                            <TextView
                                android:id="@+id/tv_applied_coupon_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_medium"
                                android:text="TASTY20 applied! 20% discount"
                                android:textColor="@color/status_basil"
                                android:textSize="12sp" />

                            <ImageButton
                                android:id="@+id/btn_remove_coupon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Remove coupon"
                                android:src="@drawable/ic_remove"
                                app:tint="@color/status_basil" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bill Details Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Bill Details"
                            android:textColor="@color/text_ink"
                            android:textSize="15sp" />

                        <!-- Item Total -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Item Total"
                                android:textColor="@color/text_caption"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_bill_subtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="$0.00"
                                android:textColor="@color/text_ink"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Delivery Fee -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Delivery Fee"
                                android:textColor="@color/text_caption"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_bill_delivery_fee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="$2.99"
                                android:textColor="@color/text_ink"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Taxes & Fees -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Taxes &amp; Restaurant Charges (8%)"
                                android:textColor="@color/text_caption"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_bill_tax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="$0.00"
                                android:textColor="@color/text_ink"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Discount Row -->
                        <LinearLayout
                            android:id="@+id/layout_bill_discount_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Promo Discount"
                                android:textColor="@color/status_basil"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_bill_discount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="-$0.00"
                                android:textColor="@color/status_basil"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/border_line" />

                        <!-- Grand Total -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_bold"
                                android:text="To Pay"
                                android:textColor="@color/text_ink"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tv_bill_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="$0.00"
                                android:textColor="@color/primary_chili"
                                android:textSize="18sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Proceed to Checkout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cart_checkout"
                    style="@style/Widget.TastyGo.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="16dp"
                    android:text="Proceed to Checkout" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Empty Cart State -->
        <LinearLayout
            android:id="@+id/layout_cart_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Empty Cart"
                android:src="@drawable/ic_shopping_cart"
                app:tint="@color/text_caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Your Cart is Empty"
                android:textColor="@color/text_ink"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Explore our gourmet menu and add your favorite dishes to start ordering."
                android:textAlignment="center"
                android:textColor="@color/text_caption"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cart_start_shopping"
                style="@style/Widget.TastyGo.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="24dp"
                android:text="Browse Tasty Menu" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
