<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/border_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp">

            <!-- Food Thumbnail Image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="92dp"
                android:layout_height="92dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_line"
                app:strokeWidth="0.5dp">

                <ImageView
                    android:id="@+id/iv_admin_food_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Food image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_food_placeholder" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Food Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Veg / Non-Veg Icon -->
                    <ImageView
                        android:id="@+id/iv_admin_veg_indicator"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Dietary indicator"
                        android:src="@drawable/ic_veg" />

                    <!-- Food Name -->
                    <TextView
                        android:id="@+id/tv_admin_food_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:maxLines="1"
                        android:text="Classic Cheeseburger"
                        android:textColor="@color/text_ink"
                        android:textSize="@dimen/text_subtitle" />
                </LinearLayout>

                <!-- Category Tag & Rating -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_admin_food_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_food_placeholder"
                        android:backgroundTint="@color/primary_chili_tint"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Burgers"
                        android:textColor="@color/primary_chili"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Rating"
                        android:src="@drawable/ic_star_filled" />

                    <TextView
                        android:id="@+id/tv_admin_food_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="4.8"
                        android:textColor="@color/text_caption"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <!-- Price -->
                <TextView
                    android:id="@+id/tv_admin_food_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="$8.99"
                    android:textColor="@color/primary_chili"
                    android:textSize="@dimen/text_subtitle" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_line" />

        <!-- Bottom Controls Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_availability_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Available"
                android:textColor="@color/text_ink"
                android:textSize="@dimen/text_caption" />

            <!-- In-Stock Switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_availability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checked="true"
                app:thumbTint="@color/white"
                app:trackTint="@color/success_basil" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_admin_edit_food"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Edit"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/primary_chili" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_admin_delete_food"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Delete"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/non_veg_red" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
