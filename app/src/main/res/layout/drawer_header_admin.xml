<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primary_chili"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="48dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/iv_header_logo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_tastygo_logo" />

    <TextView
        android:id="@+id/tv_header_admin_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Administrator"
        android:textColor="@color/white"
        android:textSize="@dimen/text_title_medium" />

    <TextView
        android:id="@+id/tv_header_admin_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_regular"
        android:text="admin@tastygo.com"
        android:textColor="#E0FFFFFF"
        android:textSize="@dimen/text_caption" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/accent_butter"
        app:cardCornerRadius="@dimen/chip_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="ADMIN ACCESS"
            android:textColor="@color/text_ink"
            android:textSize="10sp" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
