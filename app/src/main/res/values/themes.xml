<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Base.Theme.TastyGo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_chili</item>
        <item name="colorPrimaryVariant">@color/primary_chili_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_butter</item>
        <item name="colorOnSecondary">@color/text_ink</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_ink</item>
        <item name="android:colorBackground">@color/bg_mist</item>
        <item name="colorOnBackground">@color/text_ink</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/bg_mist</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_card</item>

        <!-- Typography -->
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>

        <!-- Component Default Styles -->
        <item name="materialButtonStyle">@style/Widget.TastyGo.Button</item>
        <item name="materialCardViewStyle">@style/Widget.TastyGo.Card</item>
    </style>

    <style name="Theme.TastyGo" parent="Base.Theme.TastyGo" />

    <!-- TastyGo Buttons (52dp height, 16dp radius) -->
    <style name="Widget.TastyGo.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TastyGo.Button</item>
        <item name="backgroundTint">@color/primary_chili</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.TastyGo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TastyGo.Button</item>
        <item name="strokeColor">@color/primary_chili</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary_chili</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="Widget.TastyGo.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TastyGo.Button</item>
        <item name="backgroundTint">@color/primary_chili_tint</item>
        <item name="android:textColor">@color/primary_chili</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <!-- TastyGo Cards (18dp radius) -->
    <style name="Widget.TastyGo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.TastyGo.Card</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/border_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- TastyGo Shape Appearances -->
    <style name="ShapeAppearance.TastyGo.Button" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/btn_corner_radius</item>
    </style>

    <style name="ShapeAppearance.TastyGo.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="ShapeAppearance.TastyGo.Search" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/search_corner_radius</item>
    </style>

    <style name="ShapeAppearance.TastyGo.Chip" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/chip_corner_radius</item>
    </style>

    <!-- Typography Text Appearances -->
    <style name="TextAppearance.TastyGo.TitleLarge" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_title_large</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.TastyGo.TitleMedium" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_title_medium</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.TastyGo.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.TastyGo.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_caption</item>
    </style>
</resources>